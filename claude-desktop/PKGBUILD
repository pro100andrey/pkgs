# Maintainer: pro100Andrey
# Local package recipe for the official Claude Desktop Linux binaries.
#
# Anthropic publishes the app as a Debian package. The advertised download link
# (https://claude.ai/api/desktop/linux/x64/deb/latest/redirect) resolves into the
# apt pool used below, but it sits behind a Cloudflare challenge that curl and
# makepkg cannot pass, so the pool URL is used directly.
#
# Only the .deb payload (data.tar.xz) is installed; its maintainer scripts do
# Debian-only work: apt repository registration and an Ubuntu AppArmor profile.
pkgname=claude-desktop
pkgver=1.37937.3
pkgrel=1
pkgdesc="Claude Desktop: Anthropic desktop app for Claude with Cowork and Claude Code (official binary version)"
arch=('x86_64' 'aarch64')
url="https://claude.ai/download"
license=('LicenseRef-Proprietary')
conflicts=('claude' 'claude-desktop-bin' 'claude-desktop-appimage')
# Prebuilt Electron/Chromium binaries: stripping can corrupt them (embedded
# resources, V8 snapshots) and saves nothing.
options=('!strip' '!debug')
# Libraries the shipped binaries link or dlopen, translated from Debian names.
# libcap-ng/libseccomp are for the bundled virtiofsd linked in below.
depends=(alsa-lib at-spi2-core ca-certificates cairo dbus expat gcc-libs glib2
  glibc gtk3 hicolor-icon-theme libcap-ng libcups libdrm libnotify libseccomp
  libsecret libx11 libxcb libxcomposite libxdamage libxext libxfixes
  libxkbcommon libxrandr mesa nspr nss pango systemd-libs xdg-desktop-portal
  xdg-utils)
optdepends=('bubblewrap: bash sandbox for Claude Code inside the app'
  'socat: bash sandbox for Claude Code inside the app'
  'gnome-keyring: credential storage via Secret Service (GNOME)'
  'kwallet: credential storage (KDE Plasma)'
  'libdbusmenu-glib: tray icon menu'
  'libpulse: audio output through PulseAudio or PipeWire'
  'xdg-desktop-portal-gtk: portal backend for GTK desktops'
  'xdg-desktop-portal-kde: portal backend for KDE Plasma')
# Cowork runs its sandbox inside a QEMU virtual machine. Upstream keeps this
# stack in "Recommends:"; it is not needed for the rest of the app, so it stays
# optional here instead of pulling in QEMU unconditionally.
optdepends_x86_64=('qemu-system-x86: Cowork sandbox VM'
  'edk2-ovmf: UEFI firmware for the Cowork sandbox VM')
optdepends_aarch64=('qemu-system-aarch64: Cowork sandbox VM'
  'edk2-aarch64: UEFI firmware for the Cowork sandbox VM')

_baseurl="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop"
source_x86_64=("${_baseurl}/${pkgname}_${pkgver}_amd64.deb")
source_aarch64=("${_baseurl}/${pkgname}_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  # A .deb is an ar archive, unpacked by makepkg like any other source:
  # data.tar.xz is the file payload, control.tar.xz only Debian metadata.
  bsdtar -xpf data.tar.xz -C "${pkgdir}"

  # Chromium's setuid sandbox helper, a fallback for kernels without
  # unprivileged user namespaces. The payload already carries mode 4755;
  # setting it here documents that the setuid bit is intentional.
  chmod 4755 "${pkgdir}/usr/lib/${pkgname}/chrome-sandbox"

  # Debian packaging leftover with no consumer on Arch.
  rm -r "${pkgdir}/usr/share/lintian"

  install -Dm644 "${pkgdir}/usr/share/doc/${pkgname}/copyright" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # --- Cowork compatibility shims ---------------------------------------
  # The app probes /usr/libexec/virtiofsd and /usr/bin/virtiofsd, and only
  # falls back to the copy it bundles when running on Ubuntu 22.04. Linking
  # the bundled binary into the first probed path keeps Cowork working
  # without depending on Arch's virtiofsd (which installs /usr/lib/virtiofsd).
  install -d "${pkgdir}/usr/libexec"
  ln -s "/usr/lib/${pkgname}/resources/virtiofsd" "${pkgdir}/usr/libexec/virtiofsd"

  # Firmware is opened as /usr/share/OVMF/OVMF_CODE_4M.fd, with the VARS file
  # derived by name (Debian layout). On Arch /usr/share/OVMF is edk2-ovmf's
  # compat symlink to /usr/share/edk2, where the firmware lives under x64/
  # with different names, so both Debian names are linked there.
  # aarch64 needs no shim: edk2-aarch64 already installs the probed path
  # /usr/share/AAVMF/AAVMF_CODE.fd.
  if [[ "${CARCH}" == "x86_64" ]]; then
    install -d "${pkgdir}/usr/share/edk2"
    ln -s x64/OVMF_CODE.4m.fd "${pkgdir}/usr/share/edk2/OVMF_CODE_4M.fd"
    ln -s x64/OVMF_VARS.4m.fd "${pkgdir}/usr/share/edk2/OVMF_VARS_4M.fd"
  fi
}
