# Maintainer: pro100Andrey
# Local optimized package recipe for llama.cpp.
pkgname=llama-cpp
pkgver=10819
pkgrel=1
pkgdesc="LLM inference in C/C++ (Configurable CPU/GPU build)"
arch=('x86_64')
url="https://github.com/ggml-org/llama.cpp"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cmake' 'ninja')
conflicts=('llama-cpp-git')
options=('!debug' 'strip')
source=("llama.cpp-${pkgver}.tar.gz::https://github.com/ggml-org/llama.cpp/archive/refs/tags/b${pkgver}.tar.gz")
sha256sums=('SKIP')

# Out-of-tree patches live in patches/ and are applied in filename order.
# They carry features that are not in llama.cpp master yet, so each one is
# expected to disappear again once upstream merges it.
#
#   LLAMA_PATCHES=auto (default)          -> apply every patches/*.patch
#   LLAMA_PATCHES=off                     -> apply nothing (stock upstream build)
#   LLAMA_PATCHES="0001-* 0003-foo.patch" -> apply only matching patches
#
# A patch can also be parked without touching this file by renaming it to
# something that does not end in .patch (e.g. *.patch.disabled).
_patches_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/patches" 2>/dev/null && pwd || true)"
_patches_select="${LLAMA_PATCHES:-auto}"
_patches=()

if [[ -n "${_patches_dir}" && ! "${_patches_select}" =~ ^(off|none|no|0)$ ]]; then
  for _patch_file in "${_patches_dir}"/*.patch; do
    [[ -e "${_patch_file}" ]] || continue
    _patch_name="${_patch_file##*/}"

    if [[ "${_patches_select}" =~ ^(auto|all|on|1)$ ]]; then
      _patches+=("${_patch_name}")
      continue
    fi

    # Explicit selection: names or globs, separated by spaces or commas.
    for _patch_glob in ${_patches_select//,/ }; do
      # shellcheck disable=SC2053
      if [[ "${_patch_name}" == ${_patch_glob} ]]; then
        _patches+=("${_patch_name}")
        break
      fi
    done
  done
fi

# Patches are applied straight from patches/ in prepare(); makepkg's source
# array cannot carry subdirectories for local files.
if [[ ${#_patches[@]} -eq 0 ]]; then
  echo "LLAMA_PATCHES=${_patches_select}: building stock upstream b${pkgver}"
else
  echo "LLAMA_PATCHES=${_patches_select}: ${#_patches[@]} patch(es) queued: ${_patches[*]}"
fi

# Build-time selector:
#   LLAMA_GPU_BACKEND=auto (default)      -> auto detect (NVIDIA -> cuda, else vulkan)
#   LLAMA_GPU_BACKEND=vulkan
#   LLAMA_GPU_BACKEND=cuda
#   LLAMA_GPU_BACKEND=both
#   LLAMA_GPU_BACKEND=cpu
_gpu_backend="${LLAMA_GPU_BACKEND:-auto}"

if [[ "${_gpu_backend}" == "auto" ]]; then
  _has_nvidia=0

  for _vendor_file in /sys/class/drm/card*/device/vendor /sys/bus/pci/devices/*/vendor; do
    if [[ -r "${_vendor_file}" ]] && grep -qi '^0x10de$' "${_vendor_file}"; then
      _has_nvidia=1
      break
    fi
  done

  if [[ ${_has_nvidia} -eq 1 || -d /proc/driver/nvidia ]]; then
    _gpu_backend="cuda"
  else
    _gpu_backend="vulkan"
  fi
  echo "Auto-selected LLAMA_GPU_BACKEND=${_gpu_backend}"
fi

# CUDA architecture selector (used when backend includes CUDA):
#   LLAMA_CUDA_ARCH=auto (default)         -> detect from nvidia-smi when available
#   LLAMA_CUDA_ARCH=native                 -> CMake native detection
#   LLAMA_CUDA_ARCH="86;89"               -> explicit list
_cuda_arch="${LLAMA_CUDA_ARCH:-auto}"

case "${_gpu_backend}" in
vulkan)
  depends+=('vulkan-icd-loader')
  makedepends+=('vulkan-headers')
  ;;
cuda)
  depends+=('cuda')
  makedepends+=('cuda')
  ;;
both)
  depends+=('vulkan-icd-loader' 'cuda')
  makedepends+=('vulkan-headers' 'cuda')
  ;;
cpu)
  ;;
*)
  echo "Invalid LLAMA_GPU_BACKEND='${_gpu_backend}'. Use: vulkan|cuda|both|cpu" >&2
  exit 1
  ;;
esac

prepare() {
  local patch_name

  cd "$srcdir/llama.cpp-b${pkgver}"

  for patch_name in "${_patches[@]}"; do
    # A patch that reverse-applies is already in the tarball, which is what
    # happens once upstream merges it. Skip instead of failing the build.
    if patch -p1 -R --dry-run --force --silent -i "${_patches_dir}/${patch_name}" >/dev/null 2>&1; then
      echo "==> ${patch_name}: already present in b${pkgver}, skipping"
      continue
    fi

    echo "==> Applying ${patch_name}"
    if ! patch -p1 --forward -i "${_patches_dir}/${patch_name}"; then
      echo "" >&2
      echo "Patch ${patch_name} does not apply to llama.cpp b${pkgver}." >&2
      echo "Refresh it with './scripts/llama-pkg/patches refresh', drop it from" >&2
      echo "llama-pkg/patches/, or build without patches: LLAMA_PATCHES=off" >&2
      return 1
    fi
  done
}

build() {
  local gpu_flags=()
  local cuda_flags=()
  local cpu_flags=()
  local cflags="-march=native -O3 -pipe -fno-plt -ffile-prefix-map=$srcdir=."
  local cxxflags="-march=native -O3 -pipe -fno-plt -ffile-prefix-map=$srcdir=."
  local detected_cuda_arch=""
  echo "Selected LLAMA_CPU_PROFILE=native"

  case "${_gpu_backend}" in
  vulkan)
    gpu_flags=(-DGGML_VULKAN=ON -DGGML_CUDA=OFF)
    ;;
  cuda)
    gpu_flags=(-DGGML_VULKAN=OFF -DGGML_CUDA=ON)
    ;;
  both)
    gpu_flags=(-DGGML_VULKAN=ON -DGGML_CUDA=ON)
    ;;
  cpu)
    gpu_flags=(-DGGML_VULKAN=OFF -DGGML_CUDA=OFF)
    ;;
  esac

  if [[ "${_gpu_backend}" == "cuda" || "${_gpu_backend}" == "both" ]]; then
    case "${_cuda_arch}" in
    auto)
      if command -v nvidia-smi >/dev/null 2>&1; then
        detected_cuda_arch="$({
          nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null |
            sed 's/[[:space:]]//g' |
            awk -F. 'NF >= 2 {print $1 $2}' |
            sort -u |
            paste -sd';' -
        } || true)"
      fi

      if [[ -n "${detected_cuda_arch}" ]]; then
        cuda_flags+=("-DCMAKE_CUDA_ARCHITECTURES=${detected_cuda_arch}")
        echo "Auto-selected LLAMA_CUDA_ARCH=${detected_cuda_arch}"
      else
        echo "LLAMA_CUDA_ARCH=auto: using CMake default CUDA arch detection"
      fi
      ;;
    native)
      cuda_flags+=("-DCMAKE_CUDA_ARCHITECTURES=native")
      echo "Selected LLAMA_CUDA_ARCH=native"
      ;;
    *)
      if [[ "${_cuda_arch}" =~ ^[0-9]+([;,][0-9]+)*$ ]]; then
        cuda_flags+=("-DCMAKE_CUDA_ARCHITECTURES=${_cuda_arch//,/;}")
        echo "Selected LLAMA_CUDA_ARCH=${_cuda_arch//,/;}"
      else
        echo "Invalid LLAMA_CUDA_ARCH='${_cuda_arch}'. Use: auto|native|\"86;89\"" >&2
        exit 1
      fi
      ;;
    esac
  fi

  cpu_flags=(
    -DGGML_NATIVE=ON
    -DGGML_LTO=ON
  )
  cmake -B build -S "llama.cpp-b${pkgver}" -G Ninja \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    "${gpu_flags[@]}" \
    "${cuda_flags[@]}" \
    "${cpu_flags[@]}" \
    -DCMAKE_C_FLAGS="${cflags} -w" \
    -DCMAKE_CXX_FLAGS="${cxxflags} -w"
  # echo ""
  # echo "==> CMake configuration variables:"
  # cmake -LH build

  cmake --build build -j"$(nproc)"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "llama.cpp-b${pkgver}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
