# Patch:  sampling: index penalties by token id instead of scanning every candidate
# Source: https://github.com/unslothai/llama.cpp/pull/95
# Pinned: 496a8a646f19b244b5e2eaf4cf64f920ed31c1a3 (unsloth nightly pr-set)
# Base:   b11645
# Exclude: tests/*
#
# llama_sampler_penalties_apply probed the token-count map once per candidate,
# i.e. n_vocab (248k for Qwen3.5/3.6/Bonsai) lookups per sampled token to
# penalize at most penalty_last_n of them. Walks the map instead while the
# candidate array is still the identity layout. Only matters when a repeat /
# presence / frequency penalty is enabled (upstream PR: ~+11% tg on a 27B with
# presence_penalty 1.5). Output is unchanged.
#
# Applied on top of 0001/0002; no Repo/Branch header on purpose, so
# 'patches refresh' leaves it alone.
diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 521c5718e130..4c47efd06bb9 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -2960,26 +2960,52 @@ static void llama_sampler_penalties_apply(struct llama_sampler * smpl, llama_tok
         return;
     }
 
-    // Apply frequency and presence penalties to the cur_p
-    for (size_t i = 0; i < cur_p->size; ++i) {
-        const auto token_iter = ctx->token_count.find(cur_p->data[i].id);
-        if (token_iter == ctx->token_count.end()) {
-            continue;
-        }
-
-        const int count = token_iter->second;
-
+    auto penalize = [ctx](llama_token_data & cand, int count) {
         assert(count > 0 && count <= ctx->penalty_last_n);
 
         // The academic publication that described this technique actually just only divided, but that would cause tokens with negative logits to become more likely, which is obviously wrong.
         // This is common fix for this problem, which is to multiply by the penalty instead of dividing.
-        if (cur_p->data[i].logit <= 0) {
-            cur_p->data[i].logit *= ctx->penalty_repeat;
+        if (cand.logit <= 0) {
+            cand.logit *= ctx->penalty_repeat;
         } else {
-            cur_p->data[i].logit /= ctx->penalty_repeat;
+            cand.logit /= ctx->penalty_repeat;
         }
 
-        cur_p->data[i].logit -= float(count) * ctx->penalty_freq + float(count > 0) * ctx->penalty_present;
+        cand.logit -= float(count) * ctx->penalty_freq + float(count > 0) * ctx->penalty_present;
+    };
+
+    // token_count holds at most penalty_last_n entries, so walking it is much cheaper than probing it once per candidate.
+    // This needs cur_p to still be the untouched candidate array, where a token id is its own index and appears once.
+    // The check is a compare per candidate, against a map probe per candidate, and it stops at the first mismatch.
+    bool by_index = cur_p->size == (size_t) ctx->n_vocab;
+
+    if (by_index) {
+        for (size_t i = 0; i < cur_p->size; ++i) {
+            if (cur_p->data[i].id != (llama_token) i) {
+                by_index = false;
+                break;
+            }
+        }
+    }
+
+    // Apply frequency and presence penalties to the cur_p
+    if (by_index) {
+        for (const auto & it : ctx->token_count) {
+            // the history can hold ids outside the candidates (e.g. a truncated list or LLAMA_TOKEN_NULL)
+            if (it.first < 0 || (size_t) it.first >= cur_p->size) {
+                continue;
+            }
+            penalize(cur_p->data[it.first], it.second);
+        }
+    } else {
+        for (size_t i = 0; i < cur_p->size; ++i) {
+            const auto token_iter = ctx->token_count.find(cur_p->data[i].id);
+            if (token_iter == ctx->token_count.end()) {
+                continue;
+            }
+
+            penalize(cur_p->data[i], token_iter->second);
+        }
     }
 
     cur_p->sorted = false;
