# Patch:  CUDA: fuse the Hadamard rotation with the q8_1 quantize for PQ2_0 mat-vecs
# Base:   b11658
#
# 0001 folds a Hadamard-rotated activation straight into q8_1 (one fwht_quantize_q8_1
# launch instead of fwht + quantize_q8_1 per consumer) only when every consumer is a
# PTQ1_0 mat-vec. Bonsai PQ2_0 models paid both launches on every rotated input.
# The matcher now also accepts consumers that are all PQ2_0 mat-vecs (one weight type
# per rotation, since it picks the q8_1 layout), and the fused quantizer learns the
# GGML_CUDA_Q8_1_PQ2 layout of the Ada 3-8 column kernel (mmvq-pq2_0.cuh), byte for
# byte as quantize_q8_1<GGML_CUDA_Q8_1_PQ2> writes it. GGML_CUDA_FWHT_FUSION=0 still
# turns the whole fusion off.
#
# RTX 4080 SUPER, Ternary-Bonsai-2-27B PQ2_0, q4_0 K/V: decode drops 337 quantize_q8_1
# launches per token (257 fwht + 337 quantize -> 257 fused);
#   tg128: 73.9/73.9 -> 75.0/74.9 t/s; MTP n_max 3 server: 148.8 -> 150.5 t/s
#   greedy outputs and draft acceptance identical with the fusion on/off for
#   n_max 1, 3 and 5 (2, 4 and 6 column verify batches).
#
# Applied on top of 0001-0007; one-off, no Repo/Branch header.
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 373209ce86a2..8dcfeffa2813 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2964,7 +2964,7 @@ static bool ggml_cuda_should_fuse_rms_norm_mul_rope(const ggml_tensor * rms_norm
 }
 
 // A Hadamard rotation of an activation ([MUL signs, RESHAPE,] MUL_MAT with GGML_HINT_SRC0_IS_HADAMARD)
-// whose every use is a PTQ1_0 mat-vec on the mmvq path does not need to exist in F32: each of those
+// whose every use is a PTQ1_0 (or every use a PQ2_0) mat-vec on the mmvq path does not need to exist in F32: each of those
 // mat-vecs quantizes it to q8_1 straight away, so the transform kernel quantizes as it goes and writes
 // the q8_1 rows (in the layout the mat-vecs expect) into its own output buffer; the mat-vecs then skip
 // their quantize launch (ggml_cuda_fwht_q8). On Bonsai 2 that removes ~390 launches per decode step.
@@ -2979,7 +2979,7 @@ static int ggml_cuda_try_fwht_q8(ggml_backend_cuda_context & ctx, const ggml_cgr
     }
     const int cc = ggml_cuda_info().devices[ctx.device].cc;
     if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_TURING) {
-        return 0; // the PTQ1_0 mmvq predicate below is only meaningful there
+        return 0; // the PTQ1_0 / PQ2_0 mmvq predicates below are only meaningful there
     }
 
     const ggml_tensor * x     = nullptr;
@@ -3051,6 +3051,7 @@ static int ggml_cuda_try_fwht_q8(ggml_backend_cuda_context & ctx, const ggml_cgr
     int64_t K             = 0;
     int64_t ncols         = 0;
     int64_t ne0_padded    = 0;
+    ggml_type wtype       = GGML_TYPE_COUNT; // weight type shared by every consumer: it picks the q8_1 layout
     ggml_cuda_q8_1_layout layout = GGML_CUDA_Q8_1_AOS;
     for (int j = i_mm + 1; j < cgraph->n_nodes; ++j) {
         ggml_tensor * t = cgraph->nodes[j];
@@ -3079,14 +3080,17 @@ static int ggml_cuda_try_fwht_q8(ggml_backend_cuda_context & ctx, const ggml_cgr
                 uses_expected += ggml_node_get_use_count(cgraph, j);
                 continue;
             }
-            if (t->op != GGML_OP_MUL_MAT || s != 1 || !t->src[0] || t->src[0]->type != GGML_TYPE_PTQ1_0 ||
+            if (t->op != GGML_OP_MUL_MAT || s != 1 || !t->src[0] ||
+                    (t->src[0]->type != GGML_TYPE_PTQ1_0 && t->src[0]->type != GGML_TYPE_PQ2_0) ||
+                    (wtype != GGML_TYPE_COUNT && t->src[0]->type != wtype) ||
                     ggml_get_op_params_i32(t, 1) == GGML_HINT_SRC0_IS_HADAMARD ||
                     t->type != GGML_TYPE_F32 || src->type != GGML_TYPE_F32 || !ggml_is_contiguous(src) ||
                     src->ne[2] != 1 || src->ne[3] != 1 ||
                     (K != 0 && (src->ne[0] != K || src->ne[1] != ncols)) ||
-                    !ggml_cuda_should_use_mmvq(GGML_TYPE_PTQ1_0, cc, src->ne[1])) {
+                    !ggml_cuda_should_use_mmvq(t->src[0]->type, cc, src->ne[1])) {
                 return 0;
             }
+            wtype = t->src[0]->type;
             K     = src->ne[0];
             ncols = src->ne[1];
             // ggml_cuda_mul_mat sends a padded compute-buffer view to cuBLAS instead
@@ -3105,7 +3109,7 @@ static int ggml_cuda_try_fwht_q8(ggml_backend_cuda_context & ctx, const ggml_cgr
     }
 
     // same (type, ncols, ids) -> layout and padding as ggml_cuda_mul_mat_vec_q
-    layout     = ggml_cuda_q8_1_layout_host(GGML_TYPE_PTQ1_0, (int) ncols, false);
+    layout     = ggml_cuda_q8_1_layout_host(wtype, (int) ncols, false);
     ne0_padded = GGML_PAD(K, MATRIX_ROW_PADDING);
     if (layout == GGML_CUDA_Q8_1_SOA_ISUM) {
         ne0_padded = GGML_PAD(ne0_padded, GGML_CUDA_PTQ1_K_PAD);
diff --git a/ggml/src/ggml-cuda/quantize.cu b/ggml/src/ggml-cuda/quantize.cu
index bcd9ff1de7d7..acbd7fffe892 100644
--- a/ggml/src/ggml-cuda/quantize.cu
+++ b/ggml/src/ggml-cuda/quantize.cu
@@ -255,6 +255,19 @@ static __global__ void fwht_quantize_q8_1(
                 half2 * ds = (half2 *) (ycol + 8*nblk*16) + kb*4 + e / QK8_1;
                 *ds = make_half2(__float2half(d), __short_as_half((short) isum));
             }
+        } else if constexpr (layout == GGML_CUDA_Q8_1_PQ2) {
+            // same bytes as quantize_q8_1<GGML_CUDA_Q8_1_PQ2> (see mmvq-pq2_0.cuh)
+            char * ycol = (char *) vy + row * (ne0 * 9 / 8);
+            const int64_t kb = i0 / QK8_1;
+            const int     e  = i0 % QK8_1;
+            ((int8_t *) ycol)[kb*QK8_1 + (e / 16)*16 + (e % 4)*4 + (e % 16)/4] = q;
+
+            int isum = q;
+            isum = warp_reduce_sum<QK8_1>(isum);
+            if (iqs == 0) {
+                half2 * ds = (half2 *) (ycol + ne0) + kb;
+                *ds = make_half2(__float2half(d), __short_as_half((short) isum));
+            }
         } else if constexpr (layout == GGML_CUDA_Q8_1_SOA_ISUM) {
             int isum = q;
             isum = warp_reduce_sum<QK8_1>(isum);
@@ -296,6 +309,7 @@ static void fwht_quantize_launch_layout(
     switch (layout) {
         case GGML_CUDA_Q8_1_PT:       FWHT_Q_LAUNCH(GGML_CUDA_Q8_1_PT);       break;
         case GGML_CUDA_Q8_1_SOA_ISUM: FWHT_Q_LAUNCH(GGML_CUDA_Q8_1_SOA_ISUM); break;
+        case GGML_CUDA_Q8_1_PQ2:      FWHT_Q_LAUNCH(GGML_CUDA_Q8_1_PQ2);      break;
         default:                      FWHT_Q_LAUNCH(GGML_CUDA_Q8_1_AOS);      break;
     }
 #undef FWHT_Q_LAUNCH
