+                        v0h[n] = w0h & 0x00FF00FFu;
+                        v1l[n] = w1l & 0x00FF00FFu;
+                        v1h[n] = w1h & 0x00FF00FFu;
+                        v2l[n] = w2l & 0x00FF00FFu;
+                        v2h[n] = w2h & 0x00FF00FFu;
+                    }
+                    // Pack the four trits of each dword (bytes 0,2 from wl, bytes 1,3 from wh) and dot with the plain activation words: three dots per column.
