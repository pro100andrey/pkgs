+    const uint16_t  qh16 = (uint16_t) b->qh[0] | ((uint16_t) b->qh[1] << 8);
+    const uint8x8_t h    = vreinterpret_u8_u16(vdup_n_u16(qh16));
+    const uint8x8_t uh   = PTQ1_TRIT8(vmul_u8(h, vld1_u8(k_qh_pow3)));
