+                                const vec2 ds1 = unpackHalf2x16(dsraw[jj].y);
+                                const vec2 ds2 = unpackHalf2x16(dsraw[jj].z);
+                                const vec2 ds3 = unpackHalf2x16(dsraw[jj].w);
