diff --git a/tools/server/server-common.h b/tools/server/server-common.h
index 5bd2ed57ab89..ba14bcd6ba57 100644
--- a/tools/server/server-common.h
+++ b/tools/server/server-common.h
@@ -399,6 +399,7 @@ struct server_slot_stats {
 
     // speculative decoding stats
     // note: the per-position breakdown lives in server_slot, it is not needed in a task result
