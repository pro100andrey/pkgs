+                        accB[jj][n] = DOT4(q1, yp1[jj], accB[jj][n]);
+                        accB[jj][n] = DOT4(q2, yp2[jj], accB[jj][n]);
+                    }
+                }
+
+                if (t == 4u) {
+                    // qh: four trit levels of two bytes -> elements 120 + 2n + h, all in sub-block 3 (the scale of accB on lane 1 at this level). Lane 0 decodes zeros.
