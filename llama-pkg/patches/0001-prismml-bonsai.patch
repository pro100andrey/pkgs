+static __dpct_inline__ int ptq1_0_trit(const block_ptq1_0 * x, const int e) {
+    uint8_t b;
+    int n;
+    if (e < 80) {
+        b = x->qs[e & 15];
+        n = e >> 4;
+    } else if (e < 120) {
+        const int t = e - 80;
+        b = x->qs[16 + (t & 7)];
+        n = t >> 3;
+    } else {
+        const int t = e - 120;
+        b = x->qh[t & 1];
+        n = t >> 1;
+    }
+
+    uint32_t v = b;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        if (i < n) {
+            v = (v * 3) & 0xFF;
+        }
+    }
+    return (int) ((v * 3) >> 8) - 1;
