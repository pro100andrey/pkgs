+                // Decode this level once per row, then dot with every column.
+                [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+                    const uint w0l = MUL3(v0l[n]);
+                    const uint w0h = MUL3(v0h[n]);
+                    const uint w1l = MUL3(v1l[n]);
+                    const uint w1h = MUL3(v1h[n]);
+                    const uint w2l = MUL3(v2l[n]);
+                    const uint w2h = MUL3(v2h[n]);
+                    if (t < 4u) {
