# Patch:  PrismML CUDA fix: quantized K/V in the short-query MMA FA path
# Base:   b11645
#
# Fix from PrismML-Eng/llama.cpp that postdates the merge/upstream-20261011
# branch 0001 is cut from:
#
#  - 9f245238 "cuda: keep quantized K/V type in the short-query MMA FA path"
#    (#355, in 'prism' since 2026-10-13). With a quantized V cache and a 3-4
#    token batch, the F16 MMA instantiation converted K/V into scratch that was
#    never reserved -> out-of-bounds writes. llama-server hits it on hybrid
#    models (Bonsai / qwen35) when it splits off the prompt tail for a context
#    checkpoint; symptoms are "////" / "3333" output, a poisoned instance, or
#    "illegal memory access" in get_rows. tests/ hunk dropped.
#
# One-off diff without a refresh branch: drop it once 0001 is refreshed from a
# branch that contains this commit (prepare() then reports it as already present).
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index 629a2e868117..32f6440e667d 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -11,8 +11,10 @@ static void ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1(ggml_backend_cuda_con
     const ggml_tensor * Q = dst->src[0];
     const ggml_tensor * V = dst->src[2];
 
+    // keep type_KV: the F16 instantiation converts K/V to f16 into scratch that
+    // ggml_cuda_flash_attn_ext_get_alloc_size does not reserve for the in-place quantized path
     if (turing_mma_available(cc) && ggml_is_quantized(V->type) && Q->ne[1] > 2 && Q->ne[1] <= 4) {
-        ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 64/ncols2, ncols2>(ctx, dst);
+        ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 64/ncols2, ncols2, type_KV>(ctx, dst);
         return;
     }
 
