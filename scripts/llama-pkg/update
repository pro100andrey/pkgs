#!/bin/bash
set -euo pipefail

# Update helper for llama-cpp PKGBUILD version fields.
#
# Commands are provided by run_update_command from scripts/common:
# current | latest | set <version> | status

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../common
source "$SCRIPT_DIR/../common"

init_package_env "llama-cpp" "llama-pkg"
PKG_DISPLAY_NAME="llama-pkg"

get_latest() {
    local tag
    # Upstream tags nightlies as bNNNNN, but also publishes semver releases
    # (v0.2.x) which now win /releases/latest. The PKGBUILD builds from the
    # bNNNNN tarballs, and the release list is not ordered by build number,
    # so take the numerically highest bNNNNN tag from the recent releases.
    tag="$(curl -sfL -H "User-Agent: pkgs-update-script" \
        "https://api.github.com/repos/ggml-org/llama.cpp/releases?per_page=100" |
        grep -o '"tag_name"[[:space:]]*:[[:space:]]*"b[0-9]\+"' |
        grep -o '[0-9]\+' |
        sort -n |
        tail -n1)"

    [[ "$tag" =~ ^[0-9]+$ ]] && echo "$tag" || return 1
}

# Patches in llama-pkg/patches/ are cut against a specific bNNNNN tarball, so a
# version bump can leave them stale. Warn instead of refreshing silently: a
# refreshed patch wants a look before it goes into a build.
post_set_pkgver() {
    local ver="$1"
    local file base stale=()

    for file in "$PKG_DIR"/patches/*.patch; do
        [[ -e "$file" ]] || continue
        base="$(sed -n '/^diff --git /q; s/^#[[:space:]]*Base:[[:space:]]*//p' "$file" | head -n1)"
        [[ "$base" == "b${ver}" ]] || stale+=("$(basename "$file")")
    done

    [[ ${#stale[@]} -gt 0 ]] || return 0

    echo "==> $PKG_DISPLAY_NAME: ${#stale[@]} patch(es) still based on an older tag: ${stale[*]}"
    echo "    Refresh with './scripts/llama-pkg/patches refresh', or build without"
    echo "    them using LLAMA_PATCHES=off."
}

run_update_command "$@"
